# Copy to .env.local for local development.
# In production (Vercel), set these in the project environment settings.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required in production. Local/dev falls back to a demo passcode if unset.
NEXT_PUBLIC_ADMIN_PASSCODE=

# --- Optional: server admin API + tighter RLS (post day-of hardening) ---
# ADMIN_API_ENABLED=true
# NEXT_PUBLIC_ADMIN_API_ENABLED=true
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_PASSCODE=                 # server-only preferred; falls back to NEXT_PUBLIC_
# ADMIN_SESSION_SECRET=           # cookie signing; falls back to service role key
